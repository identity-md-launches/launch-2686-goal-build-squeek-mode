{
  "name": "squeek-mode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && bun run scripts/package-skill.ts",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:browser": "bun tests/browser.ts",
    "test:browser:webkit": "bun tests/browser.ts --webkit",
    "social": "node scripts/render-social.mjs",
    "verify:chain": "bun run scripts/verify-chain.ts",
    "host": "bun run integrations/local-agent-host.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/bun": "1.3.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
